        "\n",
        "    \"checkpoint_path\": \"/content/pinn_stage1_fit.pt\",\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Stage 2: PINN loss landscape\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    # Each plotted parameter varies over:\n",
        "    #\n",
        "    # fitted_parameter - parameter_window\n",
        "    # fitted_parameter + parameter_window\n",
        "    \"parameter_window\": 12.0,\n",
        "\n",
        "    # Number of points along each parameter axis\n",
        "    \"n_parameter_range\": 100,\n",
        "\n",
        "    \"bc_weight\": 100.0,\n",
        "\n",
        "    \"show_grid_minimum\": True,\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Interactive controls\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"n_slider_steps\": 200,\n",
        "\n",
        "    \"slider_readout_format\": \".4f\",\n",
        "    \"slider_width\": \"275px\",\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Figure dimensions\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"solution_figure_width\": 900,\n",
