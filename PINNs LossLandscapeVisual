        "# @title Cell 0: Imports and default parameters\n",
        "\n",
        "!pip install plotly ipywidgets -q\n",
        "\n",
        "import os\n",
        "import copy\n",
        "import traceback\n",
        "\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "import plotly.graph_objects as go\n",
        "import plotly.io as pio\n",
        "import ipywidgets as widgets\n",
        "\n",
        "from google.colab import output\n",
        "from IPython.display import clear_output, display\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# COLAB SETUP\n",
        "# ============================================================\n",
        "\n",
        "output.enable_custom_widget_manager()\n",
        "pio.renderers.default = \"colab\"\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DEFAULT PARAMETERS\n",
        "#\n",
        "# CHANGED:\n",
        "# Cell 1 and Cell 2 read these values when they are called.\n",
        "# ============================================================\n",
        "\n",
        "DEFAULTS = {\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Problem and neural network\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"N\": 1,\n",
        "\n",
        "    # Options:\n",
        "    # \"Tanh\", \"Sigmoid\", \"ReLU\", \"SiLU\"\n",
        "    \"activation_name\": \"Tanh\",\n",
        "\n",
        "    \"lambda_val\": 1.0,\n",
        "\n",
        "    \"x_min\": 0.0,\n",
        "    \"x_max\": 1.0,\n",
        "\n",
        "    \"n_x\": 60,\n",
        "    \"n_solution_plot\": 500,\n",
        "\n",
        "    \"torch_dtype\": torch.float32,\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Stage 1: exact-solution fitting\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    \"n_fit_restarts\": 5,\n",
        "\n",
        "    \"n_adam_epochs\": 3000,\n",
