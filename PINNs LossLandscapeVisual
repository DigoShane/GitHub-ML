        "print(\"=\" * 70)\n",
        "print(\"DEFAULT SETTINGS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "for parameter_name, parameter_value in DEFAULTS.items():\n",
        "\n",
        "    print(\n",
        "        f\"{parameter_name:28s} = {parameter_value}\"\n",
        "    )"
