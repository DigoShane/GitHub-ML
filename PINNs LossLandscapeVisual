        "# @title Cell 2: Define run_stage2()\n",
        "\n",
        "\n",
        "def run_stage2(**overrides):\n",
        "    \"\"\"\n",
        "    Load the Stage-1 checkpoint and create the interactive\n",
        "    PINN loss-landscape explorer.\n",
        "\n",
        "    Cell-0 defaults are used unless overridden.\n",
        "\n",
        "    Examples\n",
        "    --------\n",
        "    run_stage2()\n",
        "\n",
        "    run_stage2(parameter_window=2.0)\n",
        "\n",
        "    run_stage2(\n",
        "        parameter_window=2.0,\n",
        "        n_parameter_range=150,\n",
        "        bc_weight=50.0\n",
        "    )\n",
        "    \"\"\"\n",
        "\n",
        "    # CHANGED:\n",
        "    # Read current Cell-0 defaults and apply only requested changes.\n",
        "    settings = get_settings(**overrides)\n",
        "\n",
        "    checkpoint_path = settings[\n",
        "        \"checkpoint_path\"\n",
        "    ]\n",
        "\n",
        "    if not os.path.exists(\n",
        "        checkpoint_path\n",
        "    ):\n",
        "\n",
        "        raise FileNotFoundError(\n",
        "            \"Stage-1 checkpoint was not found.\\n\\n\"\n",
        "            f\"Expected file:\\n{checkpoint_path}\\n\\n\"\n",
        "            \"Run run_stage1() first.\"\n",
        "        )\n",
        "\n",
        "    try:\n",
        "\n",
        "        checkpoint = torch.load(\n",
        "            checkpoint_path,\n",
        "            map_location=\"cpu\",\n",
        "            weights_only=False\n",
        "        )\n",
        "\n",
        "    except TypeError:\n",
        "\n",
        "        # Compatibility with older PyTorch versions.\n",
        "        checkpoint = torch.load(\n",
        "            checkpoint_path,\n",
        "            map_location=\"cpu\"\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # LOAD STAGE-1 ARCHITECTURE\n",
        "    # ========================================================\n",
        "\n",
        "    N = int(\n",
        "        checkpoint[\"N\"]\n",
        "    )\n",
        "\n",
        "    activation_name = checkpoint[\n",
        "        \"activation_name\"\n",
        "    ]\n",
        "\n",
        "    lambda_val = float(\n",
        "        checkpoint[\"lambda_val\"]\n",
        "    )\n",
        "\n",
        "    x_min = float(\n",
        "        checkpoint[\"x_min\"]\n",
        "    )\n",
        "\n",
        "    x_max = float(\n",
        "        checkpoint[\"x_max\"]\n",
        "    )\n",
        "\n",
        "    n_x = int(\n",
        "        checkpoint[\"n_x\"]\n",
        "    )\n",
        "\n",
        "    fitted_parameters = checkpoint[\n",
        "        \"fitted_parameters\"\n",
        "    ]\n",
        "\n",
        "    best_exact_fit_loss = float(\n",
        "        checkpoint[\n",
        "            \"best_exact_fit_loss\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    dtype_name = checkpoint.get(\n",
        "        \"torch_dtype_name\",\n",
        "        \"float32\"\n",
        "    )\n",
        "\n",
        "    dtype_lookup = {\n",
        "        \"float32\": torch.float32,\n",
        "        \"float64\": torch.float64\n",
        "    }\n",
        "\n",
        "    if dtype_name not in dtype_lookup:\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Unsupported saved dtype: {dtype_name}\"\n",
        "        )\n",
        "\n",
        "    dtype = dtype_lookup[\n",
        "        dtype_name\n",
        "    ]\n",
        "\n",
        "    if activation_name not in ACTIVATION_FUNCTIONS:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"Unsupported activation stored \"\n",
        "            f\"in checkpoint: {activation_name}\"\n",
        "        )\n",
        "\n",
        "    activation_fn = ACTIVATION_FUNCTIONS[\n",
        "        activation_name\n",
        "    ]\n",
        "\n",
        "    # Prevent accidental Stage-2 architecture changes.\n",
        "    locked_parameters = {\n",
        "        \"N\",\n",
        "        \"activation_name\",\n",
        "        \"lambda_val\",\n",
        "        \"x_min\",\n",
        "        \"x_max\",\n",
        "        \"n_x\",\n",
        "        \"torch_dtype\"\n",
        "    }\n",
        "\n",
        "    explicitly_changed_locked_parameters = (\n",
        "        locked_parameters\n",
        "        & set(overrides)\n",
        "    )\n",
        "\n",
        "    if explicitly_changed_locked_parameters:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"Stage 2 must use the architecture and PDE \"\n",
        "            \"stored by Stage 1.\\n\\n\"\n",
        "            \"Do not override these parameters in run_stage2():\\n\"\n",
        "            + \", \".join(\n",
        "                sorted(\n",
        "                    explicitly_changed_locked_parameters\n",
        "                )\n",
        "            )\n",
        "            + \"\\n\\nRerun run_stage1() to change them.\"\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # PROBLEM\n",
        "    # ========================================================\n",
        "\n",
        "    x = torch.linspace(\n",
        "        x_min,\n",
        "        x_max,\n",
        "        n_x,\n",
        "        dtype=dtype\n",
        "    ).view(-1, 1)\n",
        "\n",
        "    def u_exact_func(x_value):\n",
        "\n",
        "        return torch.sin(\n",
        "            torch.pi * x_value\n",
        "        )\n",
        "\n",
        "    u_exact = u_exact_func(x)\n",
        "\n",
        "    f = (\n",
        "        -torch.pi**2\n",
        "        + lambda_val\n",
        "    ) * u_exact\n",
        "\n",
        "    # ========================================================\n",
        "    # NETWORK\n",
        "    # ========================================================\n",
        "\n",
        "    class SimplePINN(nn.Module):\n",
        "\n",
        "        def __init__(\n",
        "            self,\n",
        "            number_of_neurons,\n",
        "            activation\n",
        "        ):\n",
        "\n",
        "            super().__init__()\n",
        "\n",
        "            self.layer1 = nn.Linear(\n",
        "                1,\n",
        "                number_of_neurons\n",
        "            )\n",
        "\n",
        "            self.layer2 = nn.Linear(\n",
        "                number_of_neurons,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            self.activation = activation\n",
        "\n",
        "        def forward(self, x_value):\n",
        "\n",
        "            return self.layer2(\n",
        "                self.activation(\n",
        "                    self.layer1(x_value)\n",
        "                )\n",
        "            )\n",
        "\n",
        "    model = SimplePINN(\n",
        "        number_of_neurons=N,\n",
        "        activation=activation_fn()\n",
        "    )\n",
        "\n",
        "    model.load_state_dict(\n",
        "        checkpoint[\n",
        "            \"model_state_dict\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    # ========================================================\n",
        "    # PARAMETER UTILITIES\n",
        "    # ========================================================\n",
        "\n",
        "    parameter_names = []\n",
        "\n",
        "    for i in range(N):\n",
        "        parameter_names.append(f\"w1_{i}\")\n",
        "\n",
        "    for i in range(N):\n",
        "        parameter_names.append(f\"b1_{i}\")\n",
        "\n",
        "    for i in range(N):\n",
        "        parameter_names.append(f\"w2_{i}\")\n",
        "\n",
        "    parameter_names.append(\"b2\")\n",
        "\n",
        "    parameter_pairs = [\n",
        "        (\n",
        "            parameter_names[i],\n",
        "            parameter_names[j]\n",
        "        )\n",
        "        for i in range(\n",
        "            len(parameter_names)\n",
        "        )\n",
        "        for j in range(\n",
        "            i + 1,\n",
        "            len(parameter_names)\n",
        "        )\n",
        "    ]\n",
        "\n",
        "    def set_parameter(\n",
        "        parameter_name,\n",
        "        value\n",
        "    ):\n",
        "\n",
        "        value = float(value)\n",
        "\n",
        "        with torch.no_grad():\n",
        "\n",
        "            if parameter_name.startswith(\"w1_\"):\n",
        "\n",
        "                neuron = int(\n",
        "                    parameter_name.split(\"_\")[1]\n",
        "                )\n",
        "\n",
        "                model.layer1.weight[\n",
        "                    neuron,\n",
        "                    0\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name.startswith(\"b1_\"):\n",
        "\n",
        "                neuron = int(\n",
        "                    parameter_name.split(\"_\")[1]\n",
        "                )\n",
        "\n",
        "                model.layer1.bias[\n",
        "                    neuron\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name.startswith(\"w2_\"):\n",
        "\n",
        "                neuron = int(\n",
        "                    parameter_name.split(\"_\")[1]\n",
        "                )\n",
        "\n",
        "                model.layer2.weight[\n",
        "                    0,\n",
        "                    neuron\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name == \"b2\":\n",
        "\n",
        "                model.layer2.bias[\n",
        "                    0\n",
        "                ] = value\n",
        "\n",
        "            else:\n",
        "\n",
        "                raise ValueError(\n",
        "                    f\"Unknown parameter: {parameter_name}\"\n",
        "                )\n",
        "\n",
        "    def restore_parameters(\n",
        "        parameter_values\n",
        "    ):\n",
        "\n",
        "        for name, value in parameter_values.items():\n",
        "\n",
        "            set_parameter(\n",
        "                name,\n",
        "                value\n",
        "            )\n",
        "\n",
        "    # ========================================================\n",
        "    # PINN LOSS\n",
        "    # ========================================================\n",
        "\n",
        "    def pinn_loss():\n",
        "\n",
        "        x_grad = (\n",
        "            x.detach()\n",
        "            .clone()\n",
        "            .requires_grad_(True)\n",
        "        )\n",
        "\n",
        "        u = model(\n",
        "            x_grad\n",
        "        )\n",
        "\n",
        "        du = torch.autograd.grad(\n",
        "            outputs=u,\n",
        "            inputs=x_grad,\n",
        "            grad_outputs=torch.ones_like(u),\n",
        "            create_graph=True\n",
        "        )[0]\n",
        "\n",
        "        d2u = torch.autograd.grad(\n",
        "            outputs=du,\n",
        "            inputs=x_grad,\n",
        "            grad_outputs=torch.ones_like(du),\n",
        "            create_graph=True\n",
        "        )[0]\n",
        "\n",
        "        residual = (\n",
        "            d2u\n",
        "            + lambda_val * u\n",
        "            - f\n",
        "        )\n",
        "\n",
        "        pde_loss = torch.mean(\n",
        "            residual**2\n",
        "        )\n",
        "\n",
        "        x_left = torch.tensor(\n",
        "            [[x_min]],\n",
        "            dtype=dtype\n",
        "        )\n",
        "\n",
        "        x_right = torch.tensor(\n",
        "            [[x_max]],\n",
        "            dtype=dtype\n",
        "        )\n",
        "\n",
        "        u_left = model(\n",
        "            x_left\n",
        "        )\n",
        "\n",
        "        u_right = model(\n",
        "            x_right\n",
        "        )\n",
        "\n",
        "        boundary_loss = (\n",
        "            torch.mean(u_left**2)\n",
        "            + torch.mean(u_right**2)\n",
        "        )\n",
        "\n",
        "        return (\n",
        "            pde_loss\n",
        "            + settings[\"bc_weight\"]\n",
        "            * boundary_loss\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # CREATE LOSS SURFACE\n",
        "    # ========================================================\n",
        "\n",
        "    def create_loss_surface(\n",
        "        pair_index,\n",
        "        fixed_parameter_values\n",
        "    ):\n",
        "\n",
        "        p1_name, p2_name = (\n",
        "            parameter_pairs[pair_index]\n",
        "        )\n",
        "\n",
        "        p1_fit = fitted_parameters[\n",
        "            p1_name\n",
        "        ]\n",
        "\n",
        "        p2_fit = fitted_parameters[\n",
        "            p2_name\n",
        "        ]\n",
        "\n",
        "        p1_range = np.linspace(\n",
        "            p1_fit\n",
        "            - settings[\"parameter_window\"],\n",
        "            p1_fit\n",
        "            + settings[\"parameter_window\"],\n",
        "            settings[\"n_parameter_range\"]\n",
        "        )\n",
        "\n",
        "        p2_range = np.linspace(\n",
        "            p2_fit\n",
        "            - settings[\"parameter_window\"],\n",
        "            p2_fit\n",
        "            + settings[\"parameter_window\"],\n",
        "            settings[\"n_parameter_range\"]\n",
        "        )\n",
        "\n",
        "        X, Y = np.meshgrid(\n",
        "            p1_range,\n",
        "            p2_range\n",
        "        )\n",
        "\n",
        "        Z = np.zeros(\n",
        "            (\n",
        "                len(p2_range),\n",
        "                len(p1_range)\n",
        "            ),\n",
        "            dtype=float\n",
        "        )\n",
        "\n",
        "        restore_parameters(\n",
        "            fixed_parameter_values\n",
        "        )\n",
        "\n",
        "        for row in range(\n",
        "            len(p2_range)\n",
        "        ):\n",
        "\n",
        "            for column in range(\n",
        "                len(p1_range)\n",
        "            ):\n",
        "\n",
        "                set_parameter(\n",
        "                    p1_name,\n",
        "                    X[row, column]\n",
        "                )\n",
        "\n",
        "                set_parameter(\n",
        "                    p2_name,\n",
        "                    Y[row, column]\n",
        "                )\n",
        "\n",
        "                Z[row, column] = (\n",
        "                    pinn_loss().item()\n",
        "                )\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Stage-1 fitted point\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        restore_parameters(\n",
        "            fixed_parameter_values\n",
        "        )\n",
        "\n",
        "        set_parameter(\n",
        "            p1_name,\n",
        "            p1_fit\n",
        "        )\n",
        "\n",
        "        set_parameter(\n",
        "            p2_name,\n",
        "            p2_fit\n",
        "        )\n",
        "\n",
        "        fitted_point_loss = (\n",
        "            pinn_loss().item()\n",
        "        )\n",
        "\n",
        "        figure = go.Figure()\n",
        "\n",
        "        figure.add_trace(\n",
        "            go.Surface(\n",
        "                x=X,\n",
        "                y=Y,\n",
        "                z=Z,\n",
        "                colorscale=\"Viridis\",\n",
        "                opacity=0.88,\n",
        "                name=\"PINN loss\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "        figure.add_trace(\n",
        "            go.Scatter3d(\n",
        "                x=[p1_fit],\n",
        "                y=[p2_fit],\n",
        "                z=[fitted_point_loss],\n",
        "                mode=\"markers\",\n",
        "                marker=dict(\n",
        "                    size=9,\n",
        "                    color=\"red\",\n",
        "                    symbol=\"circle\"\n",
        "                ),\n",
        "                name=\"Stage-1 fitted point\",\n",
        "                hovertemplate=(\n",
        "                    f\"{p1_name} = \"\n",
        "                    f\"{p1_fit:.10f}\"\n",
        "                    \"<br>\"\n",
        "                    f\"{p2_name} = \"\n",
        "                    f\"{p2_fit:.10f}\"\n",
        "                    \"<br>\"\n",
        "                    f\"PINN loss = \"\n",
        "                    f\"{fitted_point_loss:.10e}\"\n",
        "                    \"<extra></extra>\"\n",
        "                )\n",
        "            )\n",
        "        )\n",
        "\n",
        "        if settings[\"show_grid_minimum\"]:\n",
        "\n",
        "            grid_minimum_index = (\n",
        "                np.unravel_index(\n",
        "                    np.nanargmin(Z),\n",
        "                    Z.shape\n",
        "                )\n",
        "            )\n",
        "\n",
        "            grid_minimum_x = X[\n",
        "                grid_minimum_index\n",
        "            ]\n",
        "\n",
        "            grid_minimum_y = Y[\n",
        "                grid_minimum_index\n",
        "            ]\n",
        "\n",
        "            grid_minimum_z = Z[\n",
        "                grid_minimum_index\n",
        "            ]\n",
        "\n",
        "            figure.add_trace(\n",
        "                go.Scatter3d(\n",
        "                    x=[grid_minimum_x],\n",
        "                    y=[grid_minimum_y],\n",
        "                    z=[grid_minimum_z],\n",
        "                    mode=\"markers\",\n",
        "                    marker=dict(\n",
        "                        size=6,\n",
        "                        color=\"orange\",\n",
        "                        symbol=\"diamond\"\n",
        "                    ),\n",
        "                    name=\"Sampled PINN minimum\",\n",
        "                    hovertemplate=(\n",
        "                        f\"{p1_name} = \"\n",
        "                        f\"{grid_minimum_x:.10f}\"\n",
        "                        \"<br>\"\n",
        "                        f\"{p2_name} = \"\n",
        "                        f\"{grid_minimum_y:.10f}\"\n",
        "                        \"<br>\"\n",
        "                        f\"PINN loss = \"\n",
        "                        f\"{grid_minimum_z:.10e}\"\n",
        "                        \"<extra></extra>\"\n",
        "                    )\n",
        "                )\n",
        "            )\n",
        "\n",
        "        figure.update_layout(\n",
        "            title=(\n",
        "                \"PINN loss landscape around \"\n",
        "                \"the Stage-1 fitted point\"\n",
        "                \"<br>\"\n",
        "                \"<sup>\"\n",
        "                f\"N = {N}, \"\n",
        "                f\"activation = {activation_name}, \"\n",
        "                f\"{p1_name} versus {p2_name}\"\n",
        "                \"</sup>\"\n",
        "            ),\n",
        "            scene=dict(\n",
        "                xaxis_title=p1_name,\n",
        "                yaxis_title=p2_name,\n",
        "                zaxis_title=\"PINN loss\",\n",
        "                camera=dict(\n",
        "                    eye=dict(\n",
        "                        x=1.8,\n",
        "                        y=1.8,\n",
        "                        z=1.3\n",
        "                    )\n",
        "                )\n",
        "            ),\n",
        "            width=settings[\n",
        "                \"landscape_figure_width\"\n",
        "            ],\n",
        "            height=settings[\n",
        "                \"landscape_figure_height\"\n",
        "            ],\n",
        "            legend=dict(\n",
        "                x=0.01,\n",
        "                y=0.99\n",
        "            )\n",
        "        )\n",
        "\n",
        "        return figure\n",
        "\n",
        "    # ========================================================\n",
        "    # CONTROLS\n",
        "    # ========================================================\n",
        "\n",
        "    pair_dropdown = widgets.Dropdown(\n",
        "        options=[\n",
        "            (\n",
        "                f\"{pair[0]} vs {pair[1]}\",\n",
        "                index\n",
        "            )\n",
        "            for index, pair\n",
        "            in enumerate(parameter_pairs)\n",
        "        ],\n",
        "        value=0,\n",
        "        description=\"Pair:\"\n",
        "    )\n",
        "\n",
        "    slider_step = max(\n",
        "        2.0\n",
        "        * settings[\"parameter_window\"]\n",
        "        / settings[\"n_slider_steps\"],\n",
        "        1.0e-6\n",
        "    )\n",
        "\n",
        "    sliders = {}\n",
        "\n",
        "    for name in parameter_names:\n",
        "\n",
        "        fitted_value = fitted_parameters[\n",
        "            name\n",
        "        ]\n",
        "\n",
        "        sliders[name] = widgets.FloatSlider(\n",
        "            min=(\n",
        "                fitted_value\n",
        "                - settings[\"parameter_window\"]\n",
        "            ),\n",
        "            max=(\n",
        "                fitted_value\n",
        "                + settings[\"parameter_window\"]\n",
        "            ),\n",
        "            step=slider_step,\n",
        "            value=fitted_value,\n",
        "            description=name + \":\",\n",
        "            continuous_update=False,\n",
        "            readout_format=settings[\n",
        "                \"slider_readout_format\"\n",
        "            ],\n",
        "            style={\n",
        "                \"description_width\": \"60px\"\n",
        "            },\n",
        "            layout=widgets.Layout(\n",
        "                width=settings[\n",
        "                    \"slider_width\"\n",
        "                ]\n",
        "            )\n",
        "        )\n",
        "\n",
        "    update_button = widgets.Button(\n",
        "        description=\"Update plot\",\n",
        "        button_style=\"primary\",\n",
        "        icon=\"refresh\"\n",
        "    )\n",
        "\n",
        "    reset_button = widgets.Button(\n",
        "        description=\"Reset to fitted values\",\n",
        "        icon=\"undo\"\n",
        "    )\n",
        "\n",
        "    plot_output = widgets.Output(\n",
        "        layout=widgets.Layout(\n",
        "            width=settings[\n",
        "                \"plot_output_width\"\n",
        "            ],\n",
        "            min_width=settings[\n",
        "                \"plot_output_width\"\n",
        "            ],\n",
        "            min_height=\"750px\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    def update_slider_states(\n",
        "        change=None\n",
        "    ):\n",
        "\n",
        "        selected_pair = set(\n",
        "            parameter_pairs[\n",
        "                pair_dropdown.value\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        for name, slider in sliders.items():\n",
        "\n",
        "            slider.disabled = (\n",
        "                name in selected_pair\n",
        "            )\n",
        "\n",
        "    pair_dropdown.observe(\n",
        "        update_slider_states,\n",
        "        names=\"value\"\n",
        "    )\n",
        "\n",
        "    update_slider_states()\n",
        "\n",
        "    def reset_to_fitted_values(_):\n",
        "\n",
        "        for name, slider in sliders.items():\n",
        "\n",
        "            slider.value = (\n",
        "                fitted_parameters[name]\n",
        "            )\n",
        "\n",
        "    reset_button.on_click(\n",
        "        reset_to_fitted_values\n",
        "    )\n",
        "\n",
        "    def update_plot(_=None):\n",
        "\n",
        "        with plot_output:\n",
        "\n",
        "            clear_output(\n",
        "                wait=True\n",
        "            )\n",
        "\n",
        "            try:\n",
        "\n",
        "                print(\n",
        "                    \"Calculating PINN-loss surface...\"\n",
        "                )\n",
        "\n",
        "                fixed_parameter_values = {\n",
        "                    name: slider.value\n",
        "                    for name, slider\n",
        "                    in sliders.items()\n",
        "                }\n",
        "\n",
        "                figure = create_loss_surface(\n",
        "                    pair_index=(\n",
        "                        pair_dropdown.value\n",
        "                    ),\n",
        "                    fixed_parameter_values=(\n",
