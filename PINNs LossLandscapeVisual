        "            ),\n",
        "            *sliders.values(),\n",
        "            update_button,\n",
        "            reset_button\n",
        "        ],\n",
        "        layout=widgets.Layout(\n",
        "            width=settings[\n",
        "                \"control_panel_width\"\n",
        "            ],\n",
        "            min_width=settings[\n",
        "                \"control_panel_width\"\n",
        "            ],\n",
        "            padding=\"10px\",\n",
        "            margin=\"10px 0px 0px 10px\",\n",
        "            border=\"1px solid #cccccc\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    interface = widgets.HBox(\n",
        "        [\n",
        "            plot_output,\n",
        "            controls\n",
        "        ],\n",
        "        layout=widgets.Layout(\n",
        "            width=\"100%\",\n",
        "            align_items=\"flex-start\",\n",
        "            justify_content=\"flex-start\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(\"STAGE 2: PINN LOSS LANDSCAPE\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    print(\n",
        "        f\"Loaded checkpoint: {checkpoint_path}\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"N = {N}, \"\n",
