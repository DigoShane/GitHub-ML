      "source": [
        "# @title Cell 1: Define run_stage1()\n",
        "\n",
        "\n",
        "def run_stage1(**overrides):\n",
        "    \"\"\"\n",
        "    Fit the neural network to u_exact, plot the approximation,\n",
        "    print the fitted parameters, and save a checkpoint.\n",
        "\n",
        "    Cell-0 defaults are used unless overridden.\n",
        "\n",
        "    Examples\n",
        "    --------\n",
        "    run_stage1()\n",
        "\n",
        "    run_stage1(N=3)\n",
        "\n",
        "    run_stage1(\n",
        "        N=3,\n",
        "        activation_name=\"Sigmoid\",\n",
        "        n_adam_epochs=5000\n",
        "    )\n",
        "    \"\"\"\n",
        "\n",
        "    # CHANGED:\n",
        "    # Read current Cell-0 defaults and apply only requested changes.\n",
        "    settings = get_settings(**overrides)\n",
        "\n",
        "    N = settings[\"N\"]\n",
        "\n",
        "    activation_name = settings[\n",
        "        \"activation_name\"\n",
        "    ]\n",
        "\n",
        "    activation_fn = ACTIVATION_FUNCTIONS[\n",
        "        activation_name\n",
        "    ]\n",
        "\n",
        "    lambda_val = settings[\n",
        "        \"lambda_val\"\n",
        "    ]\n",
        "\n",
        "    dtype = settings[\n",
        "        \"torch_dtype\"\n",
        "    ]\n",
        "\n",
        "    # ========================================================\n",
        "    # PROBLEM\n",
        "    # ========================================================\n",
        "\n",
        "    x = torch.linspace(\n",
        "        settings[\"x_min\"],\n",
        "        settings[\"x_max\"],\n",
        "        settings[\"n_x\"],\n",
        "        dtype=dtype\n",
        "    ).view(-1, 1)\n",
        "\n",
        "    def u_exact_func(x_value):\n",
        "\n",
        "        return torch.sin( 3 * torch.pi * x_value)\n",
        "\n",
        "    u_exact = u_exact_func(x)\n",
        "\n",
        "    # PDE:\n",
        "    #\n",
        "    #     u'' + lambda*u = f\n",
        "    #\n",
        "    f = (\n",
        "        -torch.pi**2\n",
        "        + lambda_val\n",
        "    ) * u_exact\n",
        "\n",
        "    # ========================================================\n",
        "    # NETWORK\n",
        "    # ========================================================\n",
        "\n",
        "    class SimplePINN(nn.Module):\n",
        "\n",
        "        def __init__(\n",
        "            self,\n",
        "            number_of_neurons,\n",
        "            activation\n",
        "        ):\n",
        "\n",
        "            super().__init__()\n",
        "\n",
        "            self.N = number_of_neurons\n",
        "\n",
        "            self.layer1 = nn.Linear(\n",
        "                1,\n",
        "                number_of_neurons\n",
        "            )\n",
        "\n",
        "            self.layer2 = nn.Linear(\n",
        "                number_of_neurons,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            self.activation = activation\n",
        "\n",
        "        def forward(self, x_value):\n",
        "\n",
        "            hidden = self.activation(\n",
        "                self.layer1(x_value)\n",
        "            )\n",
        "\n",
        "            return self.layer2(hidden)\n",
        "\n",
        "    # ========================================================\n",
        "    # PARAMETER UTILITIES\n",
        "    # ========================================================\n",
        "\n",
        "    def make_parameter_names():\n",
        "\n",
        "        names = []\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"w1_{i}\")\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"b1_{i}\")\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"w2_{i}\")\n",
        "\n",
        "        names.append(\"b2\")\n",
        "\n",
        "        return names\n",
        "\n",
        "    def get_parameter(\n",
        "        model,\n",
        "        parameter_name\n",
        "    ):\n",
        "\n",
        "        if parameter_name.startswith(\"w1_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer1.weight[\n",
        "                neuron,\n",
        "                0\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name.startswith(\"b1_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer1.bias[\n",
        "                neuron\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name.startswith(\"w2_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer2.weight[\n",
        "                0,\n",
        "                neuron\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name == \"b2\":\n",
        "\n",
        "            return model.layer2.bias[\n",
        "                0\n",
        "            ].item()\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Unknown parameter: {parameter_name}\"\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # FITTING LOSS\n",
        "    # ========================================================\n",
        "\n",
        "    def exact_fit_loss(model):\n",
        "\n",
        "        u_approx = model(x)\n",
        "\n",
        "        return torch.mean(\n",
        "            (u_approx - u_exact)**2\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAINING\n",
        "    # ========================================================\n",
        "\n",
        "    best_fit_loss = np.inf\n",
        "    best_state = None\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(\"STAGE 1: FITTING THE NETWORK TO u_exact\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    print(\n",
        "        f\"N = {N}, \"\n",
        "        f\"activation = {activation_name}\"\n",
        "    )\n",
        "\n",
        "    for restart in range(\n",
        "        settings[\"n_fit_restarts\"]\n",
        "    ):\n",
        "\n",
        "        torch.manual_seed(\n",
        "            settings[\"random_seed_base\"]\n",
        "            + restart\n",
        "        )\n",
        "\n",
        "        candidate_model = SimplePINN(\n",
        "            number_of_neurons=N,\n",
        "            activation=activation_fn()\n",
        "        )\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Adam\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        adam_optimizer = torch.optim.Adam(\n",
        "            candidate_model.parameters(),\n",
        "            lr=settings[\n",
        "                \"adam_learning_rate\"\n",
        "            ]\n",
        "        )\n",
