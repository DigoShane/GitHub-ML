      "source": [
        "# Install before importing\n",
        "!pip install plotly ipywidgets -q\n",
        "\n",
        "import traceback\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import numpy as np\n",
        "import plotly.graph_objects as go\n",
        "import plotly.io as pio\n",
        "import ipywidgets as widgets\n",
        "\n",
        "from google.colab import output\n",
        "from IPython.display import clear_output, display\n",
        "\n",
        "# Enable widgets in Google Colab\n",
        "output.enable_custom_widget_manager()\n",
        "\n",
        "# Plotly renderer for Google Colab\n",
        "pio.renderers.default = \"colab\"\n",
        "\n",
        "\n",
        "# ========================== PROBLEM SETUP ==========================\n",
        "\n",
        "lambda_val = 1.0\n",
        "\n",
        "x = torch.linspace(0.0,1.0,60,dtype=torch.float32).view(-1, 1)\n",
        "\n",
        "\n",
        "def u_exact_func(x):\n",
        "    return torch.sin(torch.pi * x)\n",
        "\n",
        "u_exact = u_exact_func(x)\n",
        "\n",
        "f = (-torch.pi**2 + lambda_val) * u_exact\n",
        "\n",
        "\n",
        "# ========================== NEURAL NETWORK ==========================\n",
        "\n",
        "class SimplePINN(nn.Module):\n",
        "\n",
        "    def __init__(self, N, activation=None):\n",
        "        super().__init__()\n",
        "\n",
        "        self.N = N\n",
        "\n",
        "        self.layer1 = nn.Linear(1, N)\n",
        "        self.layer2 = nn.Linear(N, 1)\n",
        "\n",
        "        if activation is None:\n",
        "            activation = nn.Tanh()\n",
        "\n",
        "        self.activation = activation\n",
        "\n",
        "    def forward(self, x):\n",
        "        hidden = self.activation(self.layer1(x))\n",
        "        return self.layer2(hidden)\n",
        "\n",
        "\n",
        "# ========================== PINN LOSS ==========================\n",
        "\n",
        "def pinn_loss( model, x, f, lambda_val, bc_weight=100.0):\n",
        "    x_grad = x.detach().clone().requires_grad_(True)\n",
        "    u = model(x_grad)\n",
        "    du = torch.autograd.grad( outputs=u, inputs=x_grad, grad_outputs=torch.ones_like(u), create_graph=True)[0]\n",
        "    d2u = torch.autograd.grad( outputs=du, inputs=x_grad, grad_outputs=torch.ones_like(du), create_graph=True)[0]\n",
        "\n",
        "    residual = d2u + lambda_val * u - f\n",
        "\n",
        "    pde_loss = torch.mean(residual**2)\n",
        "\n",
        "    x_left = torch.zeros( (1, 1), dtype=x.dtype)\n",
        "\n",
        "    x_right = torch.ones((1, 1), dtype=x.dtype)\n",
        "\n",
        "    u_left = model(x_left)\n",
        "    u_right = model(x_right)\n",
        "\n",
        "    bc_loss = torch.mean(u_left**2) + torch.mean(u_right**2)\n",
        "\n",
        "    total_loss = pde_loss + bc_weight * bc_loss\n",
        "\n",
        "    return total_loss\n",
        "\n",
        "\n",
        "# ========================== MAIN FUNCTION ==========================\n",
        "\n",
        "def create_full_pair_exploration(\n",
        "    N=1,\n",
        "    activation_fn=nn.Tanh\n",
        "):\n",
        "\n",
        "    activation = activation_fn()\n",
        "    model = SimplePINN(N, activation)\n",
        "\n",
        "    print(\n",
        "        f\"Interactive 3D Explorer | \"\n",
        "        f\"N={N} | \"\n",
        "        f\"Activation={activation_fn.__name__}\"\n",
        "    )\n",
        "\n",
        "    # ----------------------------------------------------------\n",
        "    # Parameter names\n",
        "    # ----------------------------------------------------------\n",
        "\n",
        "    param_names = []\n",
        "\n",
        "    for i in range(N):\n",
        "        param_names.append(f\"w1_{i}\")\n",
        "\n",
        "    for i in range(N):\n",
        "        param_names.append(f\"b1_{i}\")\n",
        "\n",
        "    for i in range(N):\n",
        "        param_names.append(f\"w2_{i}\")\n",
        "\n",
        "    param_names.append(\"b2\")\n",
        "\n",
        "    # All unique parameter pairs\n",
        "    pairs = [\n",
        "        (param_names[i], param_names[j])\n",
        "        for i in range(len(param_names))\n",
        "        for j in range(i + 1, len(param_names))\n",
        "    ]\n",
        "\n",
        "    # ----------------------------------------------------------\n",
        "    # Helper function to assign one model parameter\n",
        "    # ----------------------------------------------------------\n",
        "\n",
        "    def set_parameter(parameter_name, value):\n",
        "\n",
        "        value = float(value)\n",
        "\n",
        "        with torch.no_grad():\n",
        "\n",
        "            if parameter_name.startswith(\"w1_\"):\n",
        "\n",
        "                neuron = int(parameter_name.split(\"_\")[1])\n",
        "\n",
        "                model.layer1.weight[\n",
        "                    neuron,\n",
        "                    0\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name.startswith(\"b1_\"):\n",
        "\n",
        "                neuron = int(parameter_name.split(\"_\")[1])\n",
        "\n",
        "                model.layer1.bias[\n",
        "                    neuron\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name.startswith(\"w2_\"):\n",
        "\n",
        "                neuron = int(parameter_name.split(\"_\")[1])\n",
        "\n",
        "                model.layer2.weight[\n",
        "                    0,\n",
        "                    neuron\n",
        "                ] = value\n",
        "\n",
        "            elif parameter_name == \"b2\":\n",
        "\n",
        "                model.layer2.bias[0] = value\n",
        "\n",
        "            else:\n",
        "\n",
        "                raise ValueError(\n",
        "                    f\"Unknown parameter name: {parameter_name}\"\n",
        "                )\n",
        "\n",
        "    # ----------------------------------------------------------\n",
        "    # Construct one loss surface\n",
        "    # ----------------------------------------------------------\n",
        "\n",
        "    def plot_3d(\n",
        "        pair_idx=0,\n",
        "        **fixed_params\n",
        "    ):\n",
        "\n",
        "        p1_name, p2_name = pairs[pair_idx]\n",
        "\n",
        "        # Set all parameters to the slider values first\n",
        "        for name, value in fixed_params.items():\n",
        "            set_parameter(name, value)\n",
        "\n",
        "        parameter_range = np.linspace(-12.0,12.0,50)\n",
        "\n",
        "        X, Y = np.meshgrid(\n",
        "            parameter_range,\n",
        "            parameter_range\n",
        "        )\n",
        "\n",
        "        Z = np.zeros_like(\n",
        "            X,\n",
        "            dtype=float\n",
        "        )\n",
        "\n",
        "        for row in range(len(parameter_range)):\n",
        "\n",
        "            for column in range(len(parameter_range)):\n",
        "\n",
        "                set_parameter(\n",
        "                    p1_name,\n",
        "                    X[row, column]\n",
        "                )\n",
        "\n",
        "                set_parameter(\n",
        "                    p2_name,\n",
        "                    Y[row, column]\n",
        "                )\n",
        "\n",
        "                loss_value = pinn_loss(\n",
        "                    model=model,\n",
        "                    x=x,\n",
        "                    f=f,\n",
        "                    lambda_val=lambda_val\n",
        "                )\n",
        "\n",
        "                Z[row, column] = loss_value.item()\n",
        "\n",
        "        # Minimum on the sampled grid\n",
        "        min_index = np.unravel_index(\n",
        "            np.nanargmin(Z),\n",
        "            Z.shape\n",
        "        )\n",
        "\n",
        "        min_x = X[min_index]\n",
        "        min_y = Y[min_index]\n",
        "        min_z = Z[min_index]\n",
        "\n",
        "        figure = go.Figure()\n",
        "\n",
        "        figure.add_trace(\n",
        "            go.Surface(\n",
        "                x=X,\n",
        "                y=Y,\n",
        "                z=Z,\n",
        "                colorscale=\"Viridis\",\n",
        "                opacity=0.85,\n",
        "                name=\"Loss surface\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "        figure.add_trace(\n",
        "            go.Scatter3d(\n",
        "                x=[min_x],\n",
        "                y=[min_y],\n",
        "                z=[min_z],\n",
        "                mode=\"markers\",\n",
        "                marker=dict(\n",
        "                    size=8,\n",
        "                    color=\"red\",\n",
        "                    symbol=\"circle\"\n",
        "                ),\n",
        "                name=\"Grid minimum\"\n",
        "            )\n",
        "        )\n",
        "\n",
        "        figure.update_layout(\n",
        "            title=(\n",
        "                f\"PINN loss surface: \"\n",
        "                f\"{p1_name} vs {p2_name} \"\n",
        "                f\"(N={N})\"\n",
        "            ),\n",
        "            scene=dict(\n",
        "                xaxis_title=p1_name,\n",
        "                yaxis_title=p2_name,\n",
        "                zaxis_title=\"Loss\",\n",
        "                camera=dict(\n",
        "                    eye=dict(\n",
        "                        x=1.8,\n",
        "                        y=1.8,\n",
        "                        z=1.3\n",
        "                    )\n",
        "                )\n",
        "            ),\n",
        "            width=800,\n",
        "            height=700\n",
        "        )\n",
        "\n",
        "        return figure\n",
        "\n",
        "    # ==========================================================\n",
        "    # UI\n",
        "    #\n",
        "    # CHANGED:\n",
        "    # This entire section must remain inside the main function.\n",
        "    # ==========================================================\n",
        "\n",
        "    pair_dropdown = widgets.Dropdown(\n",
        "        options=[\n",
        "            (\n",
        "                f\"{pair[0]} vs {pair[1]}\",\n",
        "                index\n",
        "            )\n",
        "            for index, pair in enumerate(pairs)\n",
        "        ],\n",
        "        value=0,\n",
        "        description=\"Pair:\"\n",
        "    )\n",
        "\n",
        "    sliders = {}\n",
        "\n",
        "    for name in param_names:\n",
        "\n",
        "        # Nonzero output weights prevent some initial slices\n",
        "        # from becoming completely flat.\n",
        "        if name.startswith(\"w2_\"):\n",
        "            initial_value = 1.0\n",
        "        else:\n",
        "            initial_value = 0.0\n",
        "\n",
        "        sliders[name] = widgets.FloatSlider(\n",
        "            min=-8.0,\n",
        "            max=8.0,\n",
        "            step=0.2,\n",
        "            value=initial_value,\n",
        "            description=name + \":\",\n",
        "            continuous_update=False\n",
        "        )\n",
        "\n",
        "    plot_button = widgets.Button(\n",
        "        description=\"Update plot\",\n",
        "        button_style=\"primary\",\n",
        "        icon=\"refresh\"\n",
        "    )\n",
        "\n",
        "    plot_output = widgets.Output(\n",
        "        layout=widgets.Layout(\n",
        "            width=\"100%\",\n",
        "            min_height=\"750px\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    def update_plot(_=None):\n",
        "\n",
        "        with plot_output:\n",
        "\n",
        "            clear_output(wait=True)\n",
        "\n",
        "            try:\n",
        "\n",
        "                print(\"Calculating loss surface...\")\n",
        "\n",
        "                fixed_values = {\n",
        "                    name: slider.value\n",
        "                    for name, slider in sliders.items()\n",
        "                }\n",
        "\n",
        "                figure = plot_3d(\n",
        "                    pair_idx=pair_dropdown.value,\n",
        "                    **fixed_values\n",
        "                )\n",
        "\n",
        "                clear_output(wait=True)\n",
        "\n",
        "                # CHANGED:\n",
        "                # Explicit Plotly rendering in Colab\n",
        "                figure.show(renderer=\"colab\")\n",
        "\n",
        "            except Exception:\n",
        "\n",
        "                print(\n",
        "                    \"An error occurred while constructing \"\n",
        "                    \"the loss surface:\"\n",
        "                )\n",
        "\n",
        "                traceback.print_exc()\n",
        "\n",
        "    plot_button.on_click(update_plot)\n",
        "\n",
        "    controls = widgets.VBox([ widgets.HTML(\"<h3>Controls</h3>\"), pair_dropdown, widgets.HTML(\"<b>Fixed parameter values</b>\"),\n",
        "        *sliders.values(), plot_button], layout=widgets.Layout( width=\"300px\", min_width=\"300px\", padding=\"10px\", margin=\"10px 0px 0px 10px\",\n",
        "        border=\"1px solid #cccccc\" ))\n",
        "\n",
        "    plot_output.layout = widgets.Layout( width=\"820px\", min_width=\"820px\", min_height=\"750px\")\n",
        "\n",
        "    complete_interface = widgets.HBox( [ plot_output, controls], layout=widgets.Layout( width=\"100%\", align_items=\"flex-start\", justify_content=\"flex-start\"))\n",
        "\n",
        "    display(complete_interface)\n",
        "\n",
        "    # Generate the first surface automatically\n",
        "    update_plot()\n",
        "\n",
        "    # Keep references available if needed later\n",
        "    return {\n",
        "        \"model\": model,\n",
        "        \"pairs\": pairs,\n",
        "        \"sliders\": sliders,\n",
        "        \"pair_dropdown\": pair_dropdown,\n",
        "        \"plot_button\": plot_button,\n",
        "        \"plot_output\": plot_output\n",
        "    }"
      ]
    },
