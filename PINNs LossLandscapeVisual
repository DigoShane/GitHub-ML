        "\n",
        "            except Exception:\n",
        "\n",
        "                print(\n",
        "                    \"An error occurred while \"\n",
        "                    \"constructing the loss surface:\"\n",
        "                )\n",
        "\n",
        "                traceback.print_exc()\n",
        "\n",
        "    update_button.on_click(\n",
        "        update_plot\n",
        "    )\n",
        "\n",
        "    fitted_values_text = \"<br>\".join(\n",
