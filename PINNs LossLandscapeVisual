        "import torch\n",
        "import torch.nn as nn\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from ipywidgets import FloatSlider, VBox, HBox\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import clear_output, display\n",
        "\n",
        "# ========================== PROBLEM SETUP ==========================\n",
        "lambda_val = 20.0\n",
        "x = torch.linspace(0, 1, 100).view(-1, 1)\n",
        "\n",
        "def u_exact_func(x):\n",
        "    return torch.sin(torch.pi * x)\n",
        "\n",
        "u_exact = u_exact_func(x)\n",
        "f = (-torch.pi**2 + lambda_val) * u_exact\n",
        "\n",
        "# ========================== MODEL ==========================\n",
        "class SimplePINN(nn.Module):\n",
        "    def __init__(self, N, activation=nn.Tanh()):\n",
        "        super().__init__()\n",
        "        self.N = N\n",
        "        self.layer1 = nn.Linear(1, N)\n",
        "        self.layer2 = nn.Linear(N, 1)\n",
        "        self.activation = activation\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.layer2(self.activation(self.layer1(x)))\n",
        "\n",
        "    def second_derivative(self, x):\n",
        "        x.requires_grad_(True)\n",
        "        u = self.forward(x)\n",
        "        du = torch.autograd.grad(u.sum(), x, create_graph=True)[0]\n",
        "        d2u = torch.autograd.grad(du.sum(), x, create_graph=True)[0]\n",
        "        return d2u\n",
        "\n",
        "def pinn_loss(model, x, f, lambda_val, bc_weight=100.0):\n",
        "    u = model(x)\n",
        "    u_xx = model.second_derivative(x)\n",
        "    residual = u_xx + lambda_val * u - f\n",
        "    pde_loss = torch.mean(residual**2)\n",
        "    bc_loss = model(torch.zeros(1,1))**2 + model(torch.ones(1,1))**2\n",
        "    return pde_loss + bc_weight * bc_loss\n",
        "\n",
        "# ========================== FIXED INTERACTIVE FUNCTION ==========================\n",
        "def create_interactive_loss(N=2, activation_fn=nn.Tanh):\n",
        "    activation = activation_fn()\n",
        "    model = SimplePINN(N, activation)\n",
        "\n",
        "    print(f\"Creating Full Parameter Landscape for N = {N} | Activation = {activation_fn.__name__}\")\n",
        "    print(f\"Total trainable parameters: {3*N + 1}\")\n",
        "\n",
        "    # Dynamically create sliders\n",
        "    sliders = {}\n",
        "\n",
        "    # Layer 1 weights: N parameters (shape: N x 1)\n",
        "    for i in range(N):\n",
        "        sliders[f'w1_{i}'] = FloatSlider(min=-10, max=10, step=0.1, value=0.0,\n",
        "                                        description=f'w1[{i}]:', continuous_update=False)\n",
        "\n",
        "    # Layer 1 biases: N parameters\n",
        "    for i in range(N):\n",
        "        sliders[f'b1_{i}'] = FloatSlider(min=-10, max=10, step=0.1, value=0.0,\n",
        "                                        description=f'b1[{i}]:', continuous_update=False)\n",
        "\n",
        "    # Layer 2 weights: N parameters (shape: 1 x N)\n",
        "    for i in range(N):\n",
        "        sliders[f'w2_{i}'] = FloatSlider(min=-10, max=10, step=0.1, value=1.0,\n",
        "                                        description=f'w2[{i}]:', continuous_update=False)\n",
        "\n",
        "    sliders['b2'] = FloatSlider(min=-10, max=10, step=0.1, value=0.0,\n",
        "                               description='b2:', continuous_update=False)\n",
        "\n",
        "    def update(**kwargs):\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        # Update model parameters - FIXED INDEXING\n",
        "        with torch.no_grad():\n",
        "            # Layer 1 weights: shape (N, 1)\n",
        "            for i in range(N):\n",
        "                model.layer1.weight.data[i, 0] = kwargs[f'w1_{i}']\n",
        "            # Layer 1 biases: shape (N,)\n",
        "            for i in range(N):\n",
        "                model.layer1.bias.data[i] = kwargs[f'b1_{i}']\n",
        "            # Layer 2 weights: shape (1, N)\n",
        "            for i in range(N):\n",
        "                model.layer2.weight.data[0, i] = kwargs[f'w2_{i}']\n",
        "            # Layer 2 bias\n",
        "            model.layer2.bias.data[0] = kwargs['b2']\n",
        "\n",
        "        loss_val = pinn_loss(model, x, f, lambda_val).item()\n",
        "\n",
        "        # 2D Loss Landscape (slice over w1[0] and b1[0])\n",
        "        w_range = np.linspace(-8, 8, 50)\n",
        "        b_range = np.linspace(-8, 8, 50)\n",
        "        W, B = np.meshgrid(w_range, b_range)\n",
        "        L = np.zeros_like(W)\n",
        "\n",
        "        for i in range(len(w_range)):\n",
        "            for j in range(len(b_range)):\n",
        "                with torch.no_grad():\n",
        "                    model.layer1.weight.data[0, 0] = w_range[i]\n",
        "                    model.layer1.bias.data[0] = b_range[j]\n",
        "                L[j, i] = pinn_loss(model, x, f, lambda_val).item()\n",
        "\n",
        "        fig, ax = plt.subplots(figsize=(10, 7))\n",
        "        contour = ax.contourf(W, B, L, levels=50, cmap='viridis')\n",
        "        plt.colorbar(contour, ax=ax, label='Loss')\n",
        "        ax.contour(W, B, L, levels=12, colors='white', alpha=0.3)\n",
        "\n",
        "        min_idx = np.unravel_index(np.argmin(L), L.shape)\n",
        "        ax.plot(w_range[min_idx[1]], b_range[min_idx[0]], 'ro', markersize=10, label='Approximate Minimum')\n",
        "\n",
        "        ax.set_xlabel('w1[0]')\n",
        "        ax.set_ylabel('b1[0]')\n",
        "        ax.set_title(f'Loss Landscape (N={N}) | Activation={activation_fn.__name__}\\n'\n",
        "                     f'Total Loss = {loss_val:.5f}')\n",
        "        ax.legend()\n",
        "        ax.grid(True, alpha=0.3)\n",
        "        plt.show()\n",
        "\n",
        "    # Layout\n",
        "    ui = VBox(list(sliders.values()))\n",
        "    out = widgets.interactive_output(update, sliders)\n",
        "    display(HBox([out, ui], layout=widgets.Layout(align_items='flex-start')))"
      ]
