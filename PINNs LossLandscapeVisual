        "\n",
        "    \"landscape_figure_width\": 800,\n",
        "    \"landscape_figure_height\": 700,\n",
        "\n",
        "    \"plot_output_width\": \"820px\",\n",
        "    \"control_panel_width\": \"310px\"\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# ACTIVATION FUNCTIONS\n",
        "# ============================================================\n",
        "\n",
        "ACTIVATION_FUNCTIONS = {\n",
        "    \"Tanh\": nn.Tanh,\n",
        "    \"Sigmoid\": nn.Sigmoid,\n",
        "    \"ReLU\": nn.ReLU,\n",
        "    \"SiLU\": nn.SiLU\n",
        "}\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# SETTINGS UTILITY\n",
        "# ============================================================\n",
        "\n",
        "def get_settings(**overrides):\n",
        "    \"\"\"\n",
        "    Return Cell-0 defaults with selected values overridden.\n",
        "\n",
        "    Examples\n",
        "    --------\n",
        "    get_settings()\n",
        "    get_settings(N=3)\n",
        "    get_settings(N=3, activation_name=\"Sigmoid\")\n",
        "    \"\"\"\n",
        "\n",
        "    unknown_parameters = set(overrides) - set(DEFAULTS)\n",
        "\n",
        "    if unknown_parameters:\n",
        "\n",
        "        raise KeyError(\n",
        "            \"Unknown parameter(s): \"\n",
        "            + \", \".join(sorted(unknown_parameters))\n",
        "        )\n",
        "\n",
        "    settings = DEFAULTS.copy()\n",
        "    settings.update(overrides)\n",
        "\n",
        "    if settings[\"N\"] < 1:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"N must be at least 1.\"\n",
        "        )\n",
        "\n",
        "    if settings[\"activation_name\"] not in ACTIVATION_FUNCTIONS:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"activation_name must be one of: \"\n",
        "            + \", \".join(ACTIVATION_FUNCTIONS)\n",
        "        )\n",
        "\n",
        "    if settings[\"x_max\"] <= settings[\"x_min\"]:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"x_max must be greater than x_min.\"\n",
        "        )\n",
        "\n",
        "    if settings[\"n_x\"] < 2:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"n_x must be at least 2.\"\n",
        "        )\n",
        "\n",
        "    if settings[\"parameter_window\"] <= 0:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"parameter_window must be positive.\"\n",
        "        )\n",
        "\n",
        "    if settings[\"n_parameter_range\"] < 2:\n",
        "\n",
        "        raise ValueError(\n",
        "            \"n_parameter_range must be at least 2.\"\n",
        "        )\n",
        "\n",
        "    return settings\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# DISPLAY DEFAULTS\n",
