        "# @title Cell 1: Define run_stage1()\n",
        "\n",
        "\n",
        "def run_stage1(**overrides):\n",
        "    \"\"\"\n",
        "    Fit the neural network to u_exact, plot the approximation,\n",
        "    print the fitted parameters, and save a checkpoint.\n",
        "\n",
        "    Cell-0 defaults are used unless overridden.\n",
        "\n",
        "    Examples\n",
        "    --------\n",
        "    run_stage1()\n",
        "\n",
        "    run_stage1(N=3)\n",
        "\n",
        "    run_stage1(\n",
        "        N=3,\n",
        "        activation_name=\"Sigmoid\",\n",
        "        n_adam_epochs=5000\n",
        "    )\n",
        "    \"\"\"\n",
        "\n",
        "    # CHANGED:\n",
        "    # Read current Cell-0 defaults and apply only requested changes.\n",
        "    settings = get_settings(**overrides)\n",
        "\n",
        "    N = settings[\"N\"]\n",
        "\n",
        "    activation_name = settings[\n",
        "        \"activation_name\"\n",
        "    ]\n",
        "\n",
        "    activation_fn = ACTIVATION_FUNCTIONS[\n",
        "        activation_name\n",
        "    ]\n",
        "\n",
        "    lambda_val = settings[\n",
        "        \"lambda_val\"\n",
        "    ]\n",
        "\n",
        "    dtype = settings[\n",
        "        \"torch_dtype\"\n",
        "    ]\n",
        "\n",
        "    # ========================================================\n",
        "    # PROBLEM\n",
        "    # ========================================================\n",
        "\n",
        "    x = torch.linspace(\n",
        "        settings[\"x_min\"],\n",
        "        settings[\"x_max\"],\n",
        "        settings[\"n_x\"],\n",
        "        dtype=dtype\n",
        "    ).view(-1, 1)\n",
        "\n",
        "    def u_exact_func(x_value):\n",
        "\n",
        "        return torch.sin(\n",
        "            torch.pi * x_value\n",
        "        )\n",
        "\n",
        "    u_exact = u_exact_func(x)\n",
        "\n",
        "    # PDE:\n",
        "    #\n",
        "    #     u'' + lambda*u = f\n",
        "    #\n",
        "    f = (\n",
        "        -torch.pi**2\n",
        "        + lambda_val\n",
        "    ) * u_exact\n",
        "\n",
        "    # ========================================================\n",
        "    # NETWORK\n",
        "    # ========================================================\n",
        "\n",
        "    class SimplePINN(nn.Module):\n",
        "\n",
        "        def __init__(\n",
        "            self,\n",
        "            number_of_neurons,\n",
        "            activation\n",
        "        ):\n",
        "\n",
        "            super().__init__()\n",
        "\n",
        "            self.N = number_of_neurons\n",
        "\n",
        "            self.layer1 = nn.Linear(\n",
        "                1,\n",
        "                number_of_neurons\n",
        "            )\n",
        "\n",
        "            self.layer2 = nn.Linear(\n",
        "                number_of_neurons,\n",
        "                1\n",
        "            )\n",
        "\n",
        "            self.activation = activation\n",
        "\n",
        "        def forward(self, x_value):\n",
        "\n",
        "            hidden = self.activation(\n",
        "                self.layer1(x_value)\n",
        "            )\n",
        "\n",
        "            return self.layer2(hidden)\n",
        "\n",
        "    # ========================================================\n",
        "    # PARAMETER UTILITIES\n",
        "    # ========================================================\n",
        "\n",
        "    def make_parameter_names():\n",
        "\n",
        "        names = []\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"w1_{i}\")\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"b1_{i}\")\n",
        "\n",
        "        for i in range(N):\n",
        "            names.append(f\"w2_{i}\")\n",
        "\n",
        "        names.append(\"b2\")\n",
        "\n",
        "        return names\n",
        "\n",
        "    def get_parameter(\n",
        "        model,\n",
        "        parameter_name\n",
        "    ):\n",
        "\n",
        "        if parameter_name.startswith(\"w1_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer1.weight[\n",
        "                neuron,\n",
        "                0\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name.startswith(\"b1_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer1.bias[\n",
        "                neuron\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name.startswith(\"w2_\"):\n",
        "\n",
        "            neuron = int(\n",
        "                parameter_name.split(\"_\")[1]\n",
        "            )\n",
        "\n",
        "            return model.layer2.weight[\n",
        "                0,\n",
        "                neuron\n",
        "            ].item()\n",
        "\n",
        "        if parameter_name == \"b2\":\n",
        "\n",
        "            return model.layer2.bias[\n",
        "                0\n",
        "            ].item()\n",
        "\n",
        "        raise ValueError(\n",
        "            f\"Unknown parameter: {parameter_name}\"\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # FITTING LOSS\n",
        "    # ========================================================\n",
        "\n",
        "    def exact_fit_loss(model):\n",
        "\n",
        "        u_approx = model(x)\n",
        "\n",
        "        return torch.mean(\n",
        "            (u_approx - u_exact)**2\n",
        "        )\n",
        "\n",
        "    # ========================================================\n",
        "    # TRAINING\n",
        "    # ========================================================\n",
        "\n",
        "    best_fit_loss = np.inf\n",
        "    best_state = None\n",
        "\n",
        "    print(\"=\" * 70)\n",
        "    print(\"STAGE 1: FITTING THE NETWORK TO u_exact\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    print(\n",
        "        f\"N = {N}, \"\n",
        "        f\"activation = {activation_name}\"\n",
        "    )\n",
        "\n",
        "    for restart in range(\n",
        "        settings[\"n_fit_restarts\"]\n",
        "    ):\n",
        "\n",
        "        torch.manual_seed(\n",
        "            settings[\"random_seed_base\"]\n",
        "            + restart\n",
        "        )\n",
        "\n",
        "        candidate_model = SimplePINN(\n",
        "            number_of_neurons=N,\n",
        "            activation=activation_fn()\n",
        "        )\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # Adam\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        adam_optimizer = torch.optim.Adam(\n",
        "            candidate_model.parameters(),\n",
        "            lr=settings[\n",
        "                \"adam_learning_rate\"\n",
        "            ]\n",
        "        )\n",
        "\n",
        "        for epoch in range(\n",
        "            settings[\"n_adam_epochs\"]\n",
        "        ):\n",
        "\n",
        "            adam_optimizer.zero_grad()\n",
        "\n",
        "            loss = exact_fit_loss(\n",
        "                candidate_model\n",
        "            )\n",
        "\n",
        "            loss.backward()\n",
        "\n",
        "            adam_optimizer.step()\n",
        "\n",
        "        # ----------------------------------------------------\n",
        "        # L-BFGS\n",
        "        # ----------------------------------------------------\n",
        "\n",
        "        lbfgs_optimizer = torch.optim.LBFGS(\n",
        "            candidate_model.parameters(),\n",
        "            lr=settings[\n",
        "                \"lbfgs_learning_rate\"\n",
        "            ],\n",
        "            max_iter=settings[\n",
        "                \"n_lbfgs_iterations\"\n",
        "            ],\n",
        "            tolerance_grad=settings[\n",
        "                \"lbfgs_tolerance_grad\"\n",
        "            ],\n",
        "            tolerance_change=settings[\n",
        "                \"lbfgs_tolerance_change\"\n",
        "            ],\n",
        "            line_search_fn=\"strong_wolfe\"\n",
        "        )\n",
        "\n",
        "        def closure():\n",
        "\n",
        "            lbfgs_optimizer.zero_grad()\n",
        "\n",
        "            closure_loss = exact_fit_loss(\n",
        "                candidate_model\n",
        "            )\n",
        "\n",
        "            closure_loss.backward()\n",
        "\n",
        "            return closure_loss\n",
        "\n",
        "        try:\n",
        "\n",
        "            lbfgs_optimizer.step(\n",
        "                closure\n",
        "            )\n",
        "\n",
        "        except RuntimeError as error:\n",
        "\n",
        "            print(\n",
        "                f\"Restart {restart + 1}: \"\n",
        "                f\"L-BFGS failed: {error}\"\n",
        "            )\n",
        "\n",
        "            print(\n",
        "                \"Keeping the Adam result.\"\n",
        "            )\n",
        "\n",
        "        with torch.no_grad():\n",
        "\n",
        "            final_fit_loss = exact_fit_loss(\n",
        "                candidate_model\n",
        "            ).item()\n",
        "\n",
        "        print(\n",
        "            f\"Restart {restart + 1}/\"\n",
        "            f\"{settings['n_fit_restarts']}: \"\n",
        "            f\"MSE = {final_fit_loss:.10e}\"\n",
        "        )\n",
        "\n",
        "        if final_fit_loss < best_fit_loss:\n",
        "\n",
        "            best_fit_loss = final_fit_loss\n",
        "\n",
        "            best_state = copy.deepcopy(\n",
        "                candidate_model.state_dict()\n",
        "            )\n",
        "\n",
        "    if best_state is None:\n",
        "\n",
        "        raise RuntimeError(\n",
        "            \"No valid fitted model was obtained.\"\n",
        "        )\n",
        "\n",
        "    fitted_model = SimplePINN(\n",
        "        number_of_neurons=N,\n",
        "        activation=activation_fn()\n",
        "    )\n",
        "\n",
        "    fitted_model.load_state_dict(\n",
        "        best_state\n",
        "    )\n",
        "\n",
        "    # ========================================================\n",
        "    # EXTRACT FITTED PARAMETERS\n",
        "    # ========================================================\n",
        "\n",
        "    parameter_names = make_parameter_names()\n",
        "\n",
        "    fitted_parameters = {\n",
        "        name: get_parameter(\n",
        "            fitted_model,\n",
        "            name\n",
        "        )\n",
        "        for name in parameter_names\n",
        "    }\n",
        "\n",
        "    print()\n",
        "    print(\"=\" * 70)\n",
        "    print(\"FITTED WEIGHTS AND BIASES\")\n",
        "    print(\"=\" * 70)\n",
        "\n",
        "    for name, value in fitted_parameters.items():\n",
        "\n",
        "        print(\n",
        "            f\"{name:8s} = {value: .12f}\"\n",
        "        )\n",
        "\n",
        "    print()\n",
        "    print(\n",
        "        f\"Best fitting MSE = \"\n",
        "        f\"{best_fit_loss:.12e}\"\n",
        "    )\n",
        "\n",
        "    # ========================================================\n",
        "    # PLOT u_approx OVER u_exact\n",
        "    # ========================================================\n",
        "\n",
        "    x_plot = torch.linspace(\n",
        "        settings[\"x_min\"],\n",
        "        settings[\"x_max\"],\n",
        "        settings[\"n_solution_plot\"],\n",
        "        dtype=dtype\n",
        "    ).view(-1, 1)\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        u_approx_plot = fitted_model(\n",
        "            x_plot\n",
        "        )\n",
        "\n",
        "        u_exact_plot = u_exact_func(\n",
        "            x_plot\n",
        "        )\n",
        "\n",
        "    error = (\n",
        "        u_approx_plot\n",
        "        - u_exact_plot\n",
        "    )\n",
        "\n",
        "    plot_mse = torch.mean(\n",
        "        error**2\n",
        "    ).item()\n",
        "\n",
        "    maximum_error = torch.max(\n",
        "        torch.abs(error)\n",
        "    ).item()\n",
        "\n",
        "    figure = go.Figure()\n",
        "\n",
        "    figure.add_trace(\n",
        "        go.Scatter(\n",
        "            x=x_plot.detach().cpu().numpy().flatten(),\n",
        "            y=u_exact_plot.detach().cpu().numpy().flatten(),\n",
        "            mode=\"lines\",\n",
        "            name=\"u_exact\",\n",
        "            line=dict(\n",
        "                width=6,\n",
        "                dash=\"dash\"\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "    # Added second so u_approx appears above u_exact.\n",
        "    figure.add_trace(\n",
        "        go.Scatter(\n",
        "            x=x_plot.detach().cpu().numpy().flatten(),\n",
        "            y=u_approx_plot.detach().cpu().numpy().flatten(),\n",
        "            mode=\"lines\",\n",
        "            name=\"u_approx\",\n",
        "            line=dict(\n",
        "                width=3\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "    figure.update_layout(\n",
        "        title=(\n",
        "            \"Stage 1: Neural-network fit to u_exact\"\n",
        "            \"<br>\"\n",
        "            \"<sup>\"\n",
        "            f\"N = {N}, \"\n",
        "            f\"activation = {activation_name}, \"\n",
        "            f\"MSE = {plot_mse:.10e}, \"\n",
        "            f\"maximum error = {maximum_error:.10e}\"\n",
        "            \"</sup>\"\n",
        "        ),\n",
        "        xaxis_title=\"x\",\n",
        "        yaxis_title=\"u(x)\",\n",
        "        width=settings[\n",
        "            \"solution_figure_width\"\n",
        "        ],\n",
        "        height=settings[\n",
        "            \"solution_figure_height\"\n",
        "        ],\n",
        "        hovermode=\"x unified\",\n",
        "        legend=dict(\n",
        "            x=0.02,\n",
        "            y=0.98\n",
        "        )\n",
        "    )\n",
        "\n",
        "    figure.show(\n",
        "        renderer=\"colab\"\n",
        "    )\n",
        "\n",
        "    # ========================================================\n",
        "    # SAVE CHECKPOINT\n",
        "    # ========================================================\n",
        "\n",
        "    checkpoint_path = settings[\n",
        "        \"checkpoint_path\"\n",
        "    ]\n",
        "\n",
        "    checkpoint_directory = os.path.dirname(\n",
        "        checkpoint_path\n",
        "    )\n",
        "\n",
        "    if checkpoint_directory:\n",
        "\n",
        "        os.makedirs(\n",
        "            checkpoint_directory,\n",
        "            exist_ok=True\n",
        "        )\n",
        "\n",
        "    checkpoint = {\n",
        "\n",
        "        \"N\": N,\n",
        "\n",
        "        \"activation_name\": (\n",
        "            activation_name\n",
        "        ),\n",
        "\n",
        "        \"lambda_val\": (\n",
        "            lambda_val\n",
        "        ),\n",
        "\n",
        "        \"x_min\": settings[\n",
        "            \"x_min\"\n",
        "        ],\n",
        "\n",
        "        \"x_max\": settings[\n",
        "            \"x_max\"\n",
        "        ],\n",
        "\n",
        "        \"n_x\": settings[\n",
        "            \"n_x\"\n",
        "        ],\n",
        "\n",
        "        \"torch_dtype_name\": (\n",
        "            str(dtype)\n",
        "            .replace(\"torch.\", \"\")\n",
        "        ),\n",
        "\n",
        "        \"model_state_dict\": (\n",
        "            fitted_model.state_dict()\n",
        "        ),\n",
        "\n",
        "        \"fitted_parameters\": (\n",
        "            fitted_parameters\n",
        "        ),\n",
        "\n",
        "        \"best_exact_fit_loss\": (\n",
        "            float(best_fit_loss)\n",
        "        )\n",
        "    }\n",
        "\n",
        "    torch.save(\n",
        "        checkpoint,\n",
        "        checkpoint_path\n",
        "    )\n",
        "\n",
        "    print()\n",
        "    print(\n",
        "        \"Stage-1 result saved to:\"\n",
        "    )\n",
        "    print(\n",
        "        checkpoint_path\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"model\": fitted_model,\n",
        "        \"fitted_parameters\": fitted_parameters,\n",
        "        \"best_fit_loss\": best_fit_loss,\n",
        "        \"settings\": settings,\n",
        "        \"checkpoint_path\": checkpoint_path,\n",
        "        \"figure\": figure\n",
        "    }"
      ]
